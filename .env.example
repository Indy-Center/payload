# Local development. Copy to .env and fill in; .env is never committed.
# The VPS doesn't use this file: see deploy/.env.example.

# The local Postgres from the README's "Local development" section.
DATABASE_URL=postgres://payload:payload@127.0.0.1:5432/payload
# Any long random string.
PAYLOAD_SECRET=

# Uploads stay on local disk, in media/ and private-media/, unless the R2_* settings from
# deploy/.env.example are added here.
